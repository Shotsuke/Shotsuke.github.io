<div class="post-list">
<% posts.each((post, index) => { const cats = post.categories.toArray(); %>
  <article class="post-row">
    <div class="post-date"><time datetime="<%= date_xml(post.date) %>"><span><%= date(post.date, 'MM.DD') %></span><small><%= date(post.date, 'YYYY') %></small></time></div>
    <div class="post-info"><div class="post-kicker"><% cats.forEach(cat => { %><a href="<%= url_for(cat.path) %>"><%= polar_category(cat.name) %></a><% }) %></div><h3><a href="<%= url_for(post.path) %>"><%= polar_title(post.title) %></a></h3><p><%= polar_excerpt(post) %></p></div>
    <a class="post-arrow" href="<%= url_for(post.path) %>" aria-label="阅读：<%= polar_title(post.title) %>">↗</a>
  </article>
<% }) %>
</div>
